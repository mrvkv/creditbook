{
    "expo": {
        "name": "CreditBook",
        "slug": "creditbook",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/creditbook-logo.png",
        "scheme": "creditbook",
        "userInterfaceStyle": "automatic",
        "jsEngine": "hermes",
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#4F46E5"
            },
            "allowBackup": true,
            "edgeToEdgeEnabled": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "package": "com.mockday.vivek.creditbook"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/creditbook-splash.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#4F46E5"
                }
            ],
            [
                "expo-sqlite",
                {
                    "enableFTS": true
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "c03a972d-3e3f-448f-814f-9226df341e68"
            }
        }
    }
}
